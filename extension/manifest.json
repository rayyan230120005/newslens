{
  "manifest_version": 3,
  "name": "NewsLens",
  "description": "Flags checkable posts with possible framing-bias signals.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "content-scripts/selectors.js",
        "content-scripts/twitter-extractor.js"
      ],
      "css": ["styles/blur-overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
